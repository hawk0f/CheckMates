default_platform(:ios)

XCODE_PROJECT = "iosApp.xcodeproj"
SCHEME = "iosApp"

platform :ios do
  before_all do
    ensure_env("TEAM_ID")
  end

  desc "Build the KMP framework and compile the app without signing"
  lane :build do
    gradle_framework
    build_app(
      project: XCODE_PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      skip_package_ipa: true,
      skip_archive: true,
      destination: "generic/platform=iOS Simulator"
    )
  end

  desc "Upload a new build to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true,
      in_house: false
    )

    increment_build_number(
      xcodeproj: XCODE_PROJECT,
      build_number: ENV["BUILD_NUMBER"] || latest_testflight_build_number(api_key: api_key).to_i + 1
    )

    gradle_framework

    build_app(
      project: XCODE_PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build/ipa",
      xcargs: "-allowProvisioningUpdates"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      changelog: ENV["CHANGELOG"] || "Internal build from CI"
    )
  end
end

def ensure_env(name)
  UI.user_error!("#{name} is not set — copy iosApp/Configuration/Config.xcconfig and fill it in") if ENV[name].to_s.empty?
end

def gradle_framework
  Dir.chdir("../..") do
    sh("./gradlew", ":composeApp:linkReleaseFrameworkIosArm64")
  end
end
